---
import BlogPost from '../../layouts/BlogPost.astro';
import { getCollection } from 'astro:content';
import { linksForPost, relatedPosts } from '../../data/internal-links';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  // Pass the full post set through so each page can compute its own related
  // posts without re-reading the collection per route.
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await post.render();

const related = relatedPosts(post, allPosts, 3);
const proofLinks = linksForPost(post.slug);
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  category={post.data.category}
  tags={post.data.tags}
  image={post.data.image}
  related={related}
  proofLinks={proofLinks}
>
  <Content />
</BlogPost>
