---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SHOP_PACKAGES, PRICING_SOURCE } from '../data/shop-packages';
import { WAM_PAYMENT_LINKS, WAM_LINK_PATTERN } from '../data/wam';

// Prices are resolved at build time from the ARC pricing playbook via
// src/data/pricing.snapshot.json. See src/data/shop-packages.ts.
const packages = SHOP_PACKAGES;

// WAM card payment links (3ST WAM Business). Validated here so a mistyped or
// non-WAM URL fails the build instead of shipping a broken pay button.
for (const [title, link] of Object.entries(WAM_PAYMENT_LINKS)) {
  if (link !== null && !WAM_LINK_PATTERN.test(link)) {
    throw new Error(`src/data/wam.ts: WAM link for "${title}" is not a https://wam.money/pay/ URL.`);
  }
}
const wamLinkFor = (title: string) => WAM_PAYMENT_LINKS[title] ?? '';
---

<BaseLayout
  title="Shop | Consulting and Support Packages"
  description="Book a discovery call, cloud audit, or AI consultation. Pay by card through WAM, by Wise bank transfer, or through Payoneer."
>

  <!-- PAGE HEADER -->
  <section style="padding:4rem 1.5rem 3rem;">
    <div style="max-width:1200px;margin:0 auto;">
      <p class="reveal" style="font-size:0.8125rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-accent);margin-bottom:0.5rem;">Shop</p>
      <h1 class="reveal" style="font-family:var(--font-display);font-size:clamp(2rem,5vw,3rem);font-weight:800;margin-bottom:1rem;">Book a Session</h1>
      <p class="reveal" style="font-size:1.0625rem;color:var(--color-text-muted);max-width:540px;">Select a package, pick how you want to pay, and you&apos;re booked. TTD and USD accepted.</p>
    </div>
  </section>

  <!-- PACKAGE CARDS -->
  <section style="padding:0 1.5rem 5rem;">
    <div style="max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem;">
      {packages.map(pkg => (
        <div class="card-lift reveal" style={`background:var(--color-surface);border:2px solid ${pkg.featured ? 'var(--color-accent)' : 'var(--color-border)'};border-radius:12px;padding:2rem;position:relative;display:flex;flex-direction:column;`}>
          {pkg.featured && (
            <span style="position:absolute;top:-1px;left:1.5rem;transform:translateY(-50%);background:var(--color-accent-strong);color:#fff;font-size:0.75rem;font-weight:700;padding:0.25rem 0.75rem;border-radius:100px;">Most Popular</span>
          )}
          <h2 style="font-family:var(--font-display);font-size:1.375rem;font-weight:700;margin:0 0 0.5rem;">{pkg.title}</h2>
          {pkg.price ? (
            <Fragment>
              <div style="display:flex;align-items:baseline;gap:0.5rem;margin-bottom:0.375rem;" data-price-basis={pkg.price.basis}>
                <span style="font-family:var(--font-display);font-size:2.25rem;font-weight:800;color:var(--color-accent);">{pkg.price.primary} {(pkg.price.primary === 'USD' ? pkg.price.usd : pkg.price.ttd).toLocaleString('en-US')}</span>
              </div>
              <p style="font-size:0.8125rem;color:var(--color-text-muted);margin:0 0 1rem;">~{pkg.price.primary === 'USD' ? 'TTD' : 'USD'} {(pkg.price.primary === 'USD' ? pkg.price.ttd : pkg.price.usd).toLocaleString('en-US')} &middot; {pkg.duration}</p>
            </Fragment>
          ) : (
            <Fragment>
              <div style="display:flex;align-items:baseline;gap:0.5rem;margin-bottom:0.375rem;" data-price-basis="none in playbook, quote only">
                <span style="font-family:var(--font-display);font-size:2.25rem;font-weight:800;color:var(--color-accent);">Quoted</span>
              </div>
              <p style="font-size:0.8125rem;color:var(--color-text-muted);margin:0 0 1rem;">Priced to your environment &middot; {pkg.duration}</p>
            </Fragment>
          )}
          <p style="font-size:0.9375rem;color:#D1CDC6;line-height:1.6;margin-bottom:1.5rem;min-height:4.8em;">{pkg.desc}</p>
          <ul style="list-style:none;padding:0;margin:0 0 1.75rem;display:flex;flex-direction:column;gap:0.5rem;flex:1;">
            {pkg.includes.map(item => (
              <li style="display:flex;align-items:center;gap:0.625rem;font-size:0.9rem;color:var(--color-text-muted);">
                <span style="color:var(--color-accent);font-size:1rem;">&#x2713;</span>
                {item}
              </li>
            ))}
          </ul>
          {pkg.price ? (
          <button
            type="button"
            class={`pay-now-btn btn btn-block ${pkg.featured ? 'btn-primary' : 'btn-outline'}`}
            data-title={pkg.title}
            data-usd={pkg.price.usd}
            data-ttd={pkg.price.ttd}
            data-primary={pkg.price.primary}
            data-wam={wamLinkFor(pkg.title)}
            style="font-weight:700;padding:0.875rem;border-width:2px;"
          >
            Pay Now
          </button>
          ) : (
          <a
            href="/contact/"
            data-track="project_enquiry_intent"
            data-track-context={`shop-quote-${pkg.title}`}
            class={`btn btn-block ${pkg.featured ? 'btn-primary' : 'btn-outline'}`}
            style="font-weight:700;padding:0.875rem;border-width:2px;"
          >
            Request a Quote
          </a>
          )}
        </div>
      ))}
    </div>
    <p style="max-width:1200px;margin:1.5rem auto 0;font-size:0.8125rem;color:var(--color-text-muted);">
      Prices are set in US dollars; TTD figures are approximate, at the current conversion rate. Card payments through WAM are charged in TTD.
    </p>
  </section>
  <Fragment set:html={`<!-- pricing source: ARC playbook snapshot ${PRICING_SOURCE.sha}, synced ${PRICING_SOURCE.syncedAt} -->`} />

  <!-- PAYMENT MODAL -->
  <div
    id="payment-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="payment-modal-title"
    style="display:none;position:fixed;inset:0;z-index:200;background:rgba(0,0,0,0.8);align-items:center;justify-content:center;padding:1rem;"
  >
    <div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:16px;width:100%;max-width:500px;max-height:90vh;overflow-y:auto;position:relative;display:flex;flex-direction:column;">

      <!-- Modal Header -->
      <div style="padding:1.5rem 1.5rem 1rem;border-bottom:1px solid var(--color-border);display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;flex-shrink:0;">
        <div>
          <h2 id="payment-modal-title" style="font-family:var(--font-display);font-size:1.125rem;font-weight:700;margin:0 0 0.25rem;">Choose how to pay</h2>
          <p id="modal-package-info" style="font-size:0.875rem;color:var(--color-accent);margin:0;font-weight:600;"></p>
        </div>
        <button id="modal-close-btn" type="button" class="pay-close" aria-label="Close payment options" style="background:var(--color-surface-2);border:1px solid var(--color-border);border-radius:6px;cursor:pointer;padding:0.4375rem;line-height:0;flex-shrink:0;color:var(--color-text-muted);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <!-- Tab Bar: three providers, an equal-width grid so nothing gaps or wraps -->
      <div id="modal-tab-bar" class="pay-tabs" role="tablist" aria-label="Payment method">
        <button type="button" class="modal-tab-btn pay-tab" role="tab" id="tab-wam" data-tab="wam" aria-controls="modal-tab-wam" aria-selected="true">Card (WAM)</button>
        <button type="button" class="modal-tab-btn pay-tab" role="tab" id="tab-wise" data-tab="wise" aria-controls="modal-tab-wise" aria-selected="false" tabindex="-1">Wise / Bank</button>
        <button type="button" class="modal-tab-btn pay-tab" role="tab" id="tab-payoneer" data-tab="payoneer" aria-controls="modal-tab-payoneer" aria-selected="false" tabindex="-1">Payoneer</button>
      </div>

      <!-- Tab: Card (WAM) -->
      <div id="modal-tab-wam" class="pay-panel" role="tabpanel" aria-labelledby="tab-wam">
        <p class="pay-lead">Pay by Visa or Mastercard, or from a WAM wallet, on WAM&apos;s secure hosted payment page. Payment is collected in TTD by 3 Stripes Technologies, my company, through its WAM Business account. No card details are entered on this site.</p>
        <div id="wam-direct" style="display:none;margin-bottom:1rem;">
          <a id="wam-direct-link" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-block">Pay by card with WAM &rarr;</a>
        </div>
        <div id="wam-request" class="pay-box">
          <p class="pay-box-title">Request a card payment link</p>
          <p class="pay-box-text">Enter your email and a WAM payment link for this package will be sent to you, usually within one business day. You do not need a WAM account to pay by card.</p>
          <div class="pay-form">
            <input id="wam-email" class="field-input" type="email" inputmode="email" autocomplete="email" placeholder="your@email.com" aria-label="Your email for the WAM payment link" />
            <button id="wam-btn" type="button" class="btn btn-primary btn-sm">Request Link</button>
          </div>
          <p id="wam-status" class="pay-status" role="status" style="display:none;"></p>
        </div>
        <div class="pay-book">
          <p style="font-size:0.875rem;font-weight:600;color:var(--color-text);margin:0 0 0.375rem;">Ready to lock in your slot?</p>
          <p style="font-size:0.8125rem;color:var(--color-text-muted);margin:0 0 1rem;line-height:1.5;">Once your card payment is confirmed, book your time below.</p>
          <a href="https://calendar.app.google/hxSqa4yRVmLW5fubA" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">Book Your Session &rarr;</a>
        </div>
      </div>

      <!-- Tab: Wise / Bank -->
      <div id="modal-tab-wise" class="pay-panel" role="tabpanel" aria-labelledby="tab-wise" hidden>
        <p class="pay-lead">Wire transfer in USD via Wise. Include your package name in the transfer reference.</p>
        <dl class="pay-kv">
          {[
            ['Account Name', 'Antonio Cumberbatch'],
            ['Routing (Wire &amp; ACH)', '084009519'],
            ['Account Number', '845783836016678'],
            ['Swift / BIC', 'TRWIUS35XXX'],
            ['Bank Address', 'Wise US Inc, 108 W 13th St, Wilmington, DE 19801, US'],
          ].map(([label, value]) => (
            <div class="pay-kv-row">
              <dt set:html={label}></dt>
              <dd set:html={value}></dd>
            </div>
          ))}
        </dl>
        <p class="pay-note">After sending, email <a href="mailto:antonio.cumberbatch@arccloudconsulting.com" style="color:var(--color-accent);">antonio.cumberbatch@<wbr />arccloudconsulting.com</a> with your transfer reference so your booking can be confirmed.</p>
        <div class="pay-book">
          <p style="font-size:0.875rem;font-weight:600;color:var(--color-text);margin:0 0 0.375rem;">Ready to lock in your slot?</p>
          <p style="font-size:0.8125rem;color:var(--color-text-muted);margin:0 0 1rem;line-height:1.5;">Send your transfer first, then book your time below. Antonio will confirm once payment clears.</p>
          <a href="https://calendar.app.google/hxSqa4yRVmLW5fubA" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">Book Your Session &rarr;</a>
        </div>
      </div>

      <!-- Tab: Payoneer -->
      <div id="modal-tab-payoneer" class="pay-panel" role="tabpanel" aria-labelledby="tab-payoneer" hidden>
        <p class="pay-lead">Enter your email below and Antonio will send you a Payoneer payment request directly. You can pay by card without needing a Payoneer account.</p>
        <div class="pay-box">
          <p class="pay-box-title">Request a Payoneer payment</p>
          <div class="pay-form">
            <input id="payoneer-email" class="field-input" type="email" inputmode="email" autocomplete="email" placeholder="your@email.com" aria-label="Your email for the Payoneer payment request" />
            <button id="payoneer-btn" type="button" class="btn btn-primary btn-sm">Request Link</button>
          </div>
          <p id="payoneer-status" class="pay-status" role="status" style="display:none;"></p>
          <p class="pay-box-text" style="margin:0.875rem 0 0;">Once payment is confirmed, you&apos;ll receive an email with your booking link within 24 hours on business days. You can also email <a href="mailto:antonio.cumberbatch@arccloudconsulting.com" style="color:var(--color-accent);">antonio.cumberbatch@<wbr />arccloudconsulting.com</a> with your Payoneer transaction reference to speed up confirmation.</p>
        </div>
        <div class="pay-book">
          <p style="font-size:0.875rem;font-weight:600;color:var(--color-text);margin:0 0 0.375rem;">Ready to lock in your slot?</p>
          <p style="font-size:0.8125rem;color:var(--color-text-muted);margin:0 0 1rem;line-height:1.5;">Once your payment is confirmed, book your time below.</p>
          <a href="https://calendar.app.google/hxSqa4yRVmLW5fubA" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">Book Your Session &rarr;</a>
        </div>
        <p class="pay-note" style="margin-top:1rem;">Prefer something else? Email <a href="mailto:antonio.cumberbatch@arccloudconsulting.com" style="color:var(--color-accent);">antonio.cumberbatch@<wbr />arccloudconsulting.com</a> to arrange payment before booking.</p>
      </div>

    </div>
  </div>

  <style>
    /* Payment modal. Values come from the site tokens; the panels reuse the
       same surface-2 box and accent-tint booking card the rest of /shop uses. */
    .pay-tabs {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-bottom: 1px solid var(--color-border);
      flex-shrink: 0;
    }
    .pay-tab {
      padding: 0.875rem 0.5rem;
      font-family: inherit;
      font-size: 0.8125rem;
      font-weight: 600;
      white-space: nowrap;
      background: transparent;
      border: none;
      border-bottom: 2px solid transparent;
      margin-bottom: -1px;
      color: var(--color-text-muted);
      cursor: pointer;
      transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
    }
    .pay-tab:hover { color: var(--color-text); background: rgba(255, 255, 255, 0.03); }
    .pay-tab[aria-selected="true"] { color: #fff; border-bottom-color: var(--color-accent); }
    .pay-tab:focus-visible { outline-offset: -2px; }
    .pay-panel { padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; }
    .pay-panel[hidden] { display: none; }
    .pay-lead { font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.6; margin: 0; }
    .pay-box {
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: 10px;
      padding: 1.25rem;
    }
    .pay-box-title { font-size: 0.875rem; font-weight: 600; color: var(--color-text); margin: 0 0 0.375rem; }
    .pay-box-text { font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.55; margin: 0 0 1rem; }
    .pay-form { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .pay-form .btn { white-space: nowrap; }
    .pay-status { font-size: 0.75rem; color: var(--color-text-muted); margin: 0.625rem 0 0; }
    .pay-note { font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.55; margin: 0; }
    .pay-book {
      background: rgba(255, 107, 43, 0.06);
      border: 1px solid rgba(255, 107, 43, 0.15);
      border-radius: 10px;
      padding: 1.25rem;
      text-align: center;
    }
    .pay-kv { display: flex; flex-direction: column; gap: 0.5rem; margin: 0; }
    .pay-kv-row {
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      padding: 0.75rem 1rem;
      display: grid;
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: 0.75rem;
      align-items: baseline;
    }
    .pay-kv-row dt { font-size: 0.75rem; color: var(--color-text-muted); }
    .pay-kv-row dd { margin: 0; font-size: 0.875rem; font-weight: 600; color: var(--color-text); text-align: right; font-variant-numeric: tabular-nums; }
    .pay-close { transition: color 0.15s ease, border-color 0.15s ease; }
    .pay-close:hover { color: var(--color-text); border-color: rgba(255, 107, 43, 0.45); }
    @media (max-width: 420px) {
      .pay-panel { padding: 1.25rem; }
      .pay-kv-row { grid-template-columns: 1fr; gap: 0.125rem; }
      .pay-kv-row dd { text-align: left; }
      .pay-form .btn { flex: 1 1 100%; }
    }
  </style>

  <!-- Modal logic -->
  <script is:inline>
    (function () {
      function openModal(title, usd, ttd, wamLink, primary) {
        var modal = document.getElementById('payment-modal');
        var u = Number(usd).toLocaleString('en-US'), t = Number(ttd).toLocaleString('en-US');
        // Keep each amount on one line so "(~TTD 1,125)" never splits on narrow screens.
        var info = document.getElementById('modal-package-info');
        var main = primary === 'USD' ? 'USD ' + u : 'TTD ' + t;
        var alt = primary === 'USD' ? '(~TTD ' + t + ')' : '(~USD ' + u + ')';
        info.textContent = title + ': ';
        [main, alt].forEach(function (part, idx) {
          if (idx) info.appendChild(document.createTextNode(' '));
          var span = document.createElement('span');
          span.style.whiteSpace = 'nowrap';
          span.textContent = part;
          info.appendChild(span);
        });
        var direct = document.getElementById('wam-direct');
        var directLink = document.getElementById('wam-direct-link');
        if (direct && directLink) {
          if (wamLink) { directLink.href = wamLink; direct.style.display = 'block'; }
          else { directLink.href = '#'; direct.style.display = 'none'; }
        }
        var wamStatus = document.getElementById('wam-status');
        if (wamStatus) wamStatus.style.display = 'none';
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        switchTab('wam');
        var closeBtn = document.getElementById('modal-close-btn');
        if (closeBtn) closeBtn.focus();
      }

      function closeModal() {
        var modal = document.getElementById('payment-modal');
        if (modal.style.display === 'none') return;
        modal.style.display = 'none';
        document.body.style.overflow = '';
        if (lastTrigger) lastTrigger.focus();
      }

      var TABS = ['wam', 'wise', 'payoneer'];
      var lastTrigger = null;

      function switchTab(name, focus) {
        TABS.forEach(function (t) {
          var panel = document.getElementById('modal-tab-' + t);
          var btn = document.getElementById('tab-' + t);
          var on = t === name;
          if (panel) panel.hidden = !on;
          if (btn) {
            btn.setAttribute('aria-selected', on ? 'true' : 'false');
            btn.tabIndex = on ? 0 : -1;
            if (on && focus) btn.focus();
          }
        });
      }

      document.addEventListener('click', function (e) {
        var btn = e.target.closest('.pay-now-btn');
        if (btn) {
          lastTrigger = btn;
          openModal(btn.dataset.title, btn.dataset.usd, btn.dataset.ttd, btn.dataset.wam, btn.dataset.primary);
          return;
        }
        var closeBtn = e.target.closest('#modal-close-btn');
        if (closeBtn) { closeModal(); return; }

        var tabBtn = e.target.closest('#modal-tab-bar [data-tab]');
        if (tabBtn) { switchTab(tabBtn.dataset.tab); return; }

        var wamBtn = e.target.closest('#wam-btn');
        if (wamBtn) {
          var wamInput = document.getElementById('wam-email');
          var wamStatusEl = document.getElementById('wam-status');
          var wamEmail = wamInput ? wamInput.value.trim() : '';
          if (!wamEmail || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(wamEmail)) {
            if (wamStatusEl) { wamStatusEl.textContent = 'Please enter a valid email address.'; wamStatusEl.style.display = 'block'; }
            return;
          }
          var wamPkg = document.getElementById('modal-package-info') ? document.getElementById('modal-package-info').textContent : 'Package';
          var wamSubject = encodeURIComponent('WAM card payment link request: ' + wamPkg);
          var wamBody = encodeURIComponent('Hi Antonio,\n\nPlease send me a WAM card payment link for: ' + wamPkg + '\n\nMy email: ' + wamEmail + '\n\nThanks.');
          window.location.href = 'mailto:antonio.cumberbatch@arccloudconsulting.com?subject=' + wamSubject + '&body=' + wamBody;
          if (wamStatusEl) { wamStatusEl.textContent = 'Opening your email client. The WAM payment link will be sent to you, usually within one business day.'; wamStatusEl.style.display = 'block'; }
          return;
        }

        var payoneerBtn = e.target.closest('#payoneer-btn');
        if (payoneerBtn) {
          var emailInput = document.getElementById('payoneer-email');
          var statusEl = document.getElementById('payoneer-status');
          var email = emailInput ? emailInput.value.trim() : '';
          if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            if (statusEl) { statusEl.textContent = 'Please enter a valid email address.'; statusEl.style.display = 'block'; }
            return;
          }
          var pkgInfo = document.getElementById('modal-package-info') ? document.getElementById('modal-package-info').textContent : 'Package';
          var subject = encodeURIComponent('Payoneer Payment Request: ' + pkgInfo);
          var body = encodeURIComponent('Hi Antonio,\n\nPlease send me a Payoneer payment request for: ' + pkgInfo + '\n\nMy email: ' + email + '\n\nThanks.');
          window.location.href = 'mailto:antonio.cumberbatch@arccloudconsulting.com?subject=' + subject + '&body=' + body;
          if (statusEl) { statusEl.textContent = 'Opening your email client. Antonio will send the Payoneer request within 24 hours.'; statusEl.style.display = 'block'; }
          return;
        }

        var modal = document.getElementById('payment-modal');
        if (e.target === modal) closeModal();
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { closeModal(); return; }
        // Arrow keys move between payment tabs (WAI-ARIA tabs pattern).
        var tab = e.target.closest && e.target.closest('#modal-tab-bar [role="tab"]');
        if (tab && (e.key === 'ArrowRight' || e.key === 'ArrowLeft')) {
          var i = TABS.indexOf(tab.dataset.tab);
          var next = TABS[(i + (e.key === 'ArrowRight' ? 1 : TABS.length - 1)) % TABS.length];
          switchTab(next, true);
          e.preventDefault();
        }
      });
    })();
  </script>

</BaseLayout>
