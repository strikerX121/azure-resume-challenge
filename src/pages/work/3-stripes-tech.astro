---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StaticContentFallback from '../../components/StaticContentFallback.astro';
import WorkSchema from '../../components/WorkSchema.astro';
import CaseStudyLinks from '../../components/CaseStudyLinks.astro';
import { CASE_STUDIES } from '../../data/internal-links';
import { Image } from 'astro:assets';
import rakibImg from '../../assets/images/rakib-hasan.jpg';
import ConferenceGallery from '../../components/ConferenceGallery.astro';
import { TTMA_2026 } from '../../data/events';

const team = [
  {
    name: 'Antonio Cumberbatch',
    role: 'Co-founder & Technical Lead',
    bio: 'Antonio led scoping, project management, product strategy and customer success, with hands-on Azure cloud architecture and engineering. He architected and coordinated the V3 rebuild; application implementation and design were team contributions.',
    photo: null,
  },
  {
    name: 'Rakib Hasan',
    role: 'UI/UX Designer & Frontend Developer',
    bio: 'Rakib designed the EMR user experience and interface, including clinical record layouts and patient-portal concepts.',
    photo: rakibImg,
  },
  {
    name: 'Naeem Hasan',
    role: 'Full-Stack Developer',
    bio: "Naeem built and maintained the core application layer across the EMR's development lifecycle, contributing to everything from data modelling to real-time features. He is the primary developer on ongoing maintenance and feature delivery.",
    photo: null,
  },
];

const versions = [
  {
    label: 'V1',
    status: 'Retired',
    heading: 'V1, retired',
    body: 'The first version was built on a low-code Oracle platform. It proved the concept but hit a ceiling quickly, because the platform wasn\'t suited to the kind of custom clinical logic the product needed as requirements matured.',
  },
  {
    label: 'V2',
    status: 'Retired',
    heading: 'V2, retired',
    body: 'V2 was a web application publicly presented at the T&T Medical Research Conference at the Radisson Hotel. Its patient record lists loaded the entire dataset client-side. The delivery team identified that approach as a scaling constraint and replaced it in V3.',
  },
  {
    label: 'V3',
    status: 'Live',
    heading: 'V3, current (launched 2025)',
    body: 'V3 is a ground-up rebuild with a monorepo architecture, TypeScript end-to-end and separate API and frontend layers. The core technical decision was server-driven pagination: list views query bounded pages rather than the entire dataset.\n\nThe Azure infrastructure includes a WAF layer in front of the frontend to help manage unwanted traffic.',
  },
];

// Commercial terms belong to 3ST. Visible FAQ and schema share this source.
const faq = [
  { q: 'Where can a practice evaluate the EMR and current plans?', a: 'Visit 3 Stripes Technologies for current plans and rollout options. This portfolio case study does not set product pricing or plan terms.' },
  { q: 'Can I enquire about architecture or delivery work instead?', a: 'Yes. Use the portfolio contact page for individual architecture, integration or technical delivery work, or collaboration with an existing team. Product enquiries belong with 3ST.' },
];
---

<BaseLayout
  title="3 Stripes Tech EMR | Caribbean Cloud EMR Case Study"
  description="A co-founded Caribbean EMR product: Antonio's cloud architecture and delivery leadership, project-specific team contributions and reported practice use."
  ogImage="/images/covers/3-stripes-tech.jpg"
>

  <StaticContentFallback />
  <WorkSchema
    name="3 Stripes Technologies EMR"
    description="A co-founded Caribbean EMR product: Antonio's cloud architecture and delivery leadership, project-specific team contributions and reported practice use."
    path="/work/3-stripes-tech"
    breadcrumbLabel="3 Stripes Tech EMR"
    creator={{ '@type': 'Person', name: 'Antonio Cumberbatch', url: 'https://www.antoniocumberbatch.com' }}
    about={['Electronic Medical Records', 'Healthcare IT', 'Microsoft Azure', 'NestJS', 'Azure Front Door', 'Caribbean Healthcare']}
  />


  <!-- HERO BANNER -->
  <div class="reveal case-hero">
    <!-- Generated abstract cover art (scripts/generate-covers.mjs), not a product screenshot. -->
    <picture aria-hidden="true">
      <source media="(max-width: 700px)" srcset="/images/covers/3-stripes-tech.jpg" />
      <img src="/images/covers/3-stripes-tech-wide.jpg" alt="" width="1600" height="600" loading="eager" fetchpriority="high" decoding="async" class="case-hero__art" />
    </picture>
    <div class="case-hero__scrim">
      <p class="case-hero__eyebrow" style="font-size:0.75rem;font-weight:600;text-transform:uppercase;color:var(--color-accent);margin:0 0 1rem;">Co-founded product&nbsp;&middot; Healthcare IT</p>
      <h1 style="font-family:var(--font-display);font-size:clamp(2rem,5vw,3.25rem);font-weight:800;color:#fff;margin:0 0 1rem;line-height:1.15;">3 Stripes Technologies EMR</h1>
      <p style="font-size:1.125rem;color:rgba(255,255,255,0.85);margin:0 0 0.875rem;max-width:600px;">Bringing appointments, patient records and consultation notes into one workflow for Caribbean medical practices.</p>
      <p style="font-size:0.9375rem;color:rgba(255,255,255,0.8);margin:0;max-width:600px;">I co-founded 3ST and led scoping, cloud architecture and the V3 rebuild, with application development and design delivered by the team.</p>
    </div>
  </div>

  <!-- NAV + STATS -->
  <section style="padding:2.5rem 1.5rem 2rem;">
    <div style="max-width:900px;margin:0 auto;">
      <a href="/work" style="font-size:0.875rem;color:var(--color-text-muted);text-decoration:none;display:inline-flex;align-items:center;gap:0.375rem;margin-bottom:1.5rem;">&larr; All Work</a>
      <div class="reveal" style="background:rgba(255,107,43,0.06);border:1px solid rgba(255,107,43,0.18);border-radius:14px;padding:1.25rem 1.75rem;display:flex;align-items:center;gap:1.5rem;margin-bottom:1.75rem;">
        <div style="width:80px;height:80px;border-radius:12px;background:#0F1624;border:1px solid rgba(255,255,255,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden;padding:8px;">
          <img src="/images/logos/3st-logo.svg" alt="3 Stripes Technologies logo" width="64" height="64" loading="eager" decoding="async" style="width:64px;height:64px;object-fit:contain;" />
        </div>
        <div>
          <p style="font-family:var(--font-display);font-size:1.25rem;font-weight:700;color:var(--color-text);margin:0 0 0.375rem;">3 Stripes Technologies</p>
          <span style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--color-accent);">Healthcare IT&nbsp;&middot; Azure&nbsp;&middot; Full-Stack Product</span>
          <div style="margin-top:0.625rem;">
            <a href="https://www.3stripestech.com/" target="_blank" rel="noopener noreferrer" style="font-size:0.8125rem;font-weight:600;color:var(--color-accent);text-decoration:none;border:1px solid rgba(255,107,43,0.35);border-radius:6px;padding:0.25rem 0.75rem;display:inline-flex;align-items:center;gap:0.375rem;transition:background 0.15s;" onmouseover="this.style.background='rgba(255,107,43,0.1)'" onmouseout="this.style.background='transparent'">
              Visit Site <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <section style="padding:0 1.5rem 1rem;">
    <div class="prose" style="max-width:900px;margin:0 auto;">
      <h2>At a glance</h2>
      <p>V3 launched in 2025. The product team reports practice use at ABC Paediatrics in Trinidad for appointments and clinical documentation. This is a co-founded 3ST product, distinct from my client-delivery work.</p>
      <p>For your clinic, <a href="https://www.3stripestech.com/pricing" target="_blank" rel="noopener noreferrer">view current plans and rollout options at 3ST</a>. This case covers appointments, patient records and consultation notes; patient-portal designs and other roadmap modules are not current product features.</p>
    </div>
  </section>

  <!-- TEAM -->
  <section style="padding:2rem 1.5rem 3rem;">
    <div style="max-width:900px;margin:0 auto;">
      <div class="reveal" style="margin-bottom:1.75rem;">
        <p style="font-size:0.8125rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-accent);margin:0 0 0.375rem;">The Team</p>
        <h2 style="font-family:var(--font-display);font-size:1.625rem;font-weight:800;margin:0;">Project responsibilities</h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.25rem;">
        {team.map(person => (
          <div class="card-lift reveal" style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:12px;padding:1.75rem;display:flex;flex-direction:column;align-items:center;text-align:center;">
            {person.photo ? (
              <Image src={person.photo} width={80} height={80} alt={person.name} loading="lazy" decoding="async" style="width:80px;height:80px;border-radius:50%;object-fit:cover;object-position:center top;border:2px solid var(--color-border);margin-bottom:1rem;flex-shrink:0;" />
            ) : (
              <div style="width:80px;height:80px;border-radius:50%;background:var(--color-surface-2);border:2px dashed var(--color-border);display:flex;align-items:center;justify-content:center;margin-bottom:1rem;flex-shrink:0;">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
              </div>
            )}
            <p style="font-family:var(--font-display);font-size:1rem;font-weight:700;color:var(--color-text);margin:0 0 0.25rem;">{person.name}</p>
            <p style="font-size:0.8125rem;font-weight:600;color:var(--color-accent);margin:0 0 0.875rem;">{person.role}</p>
            <p style="font-size:0.875rem;color:var(--color-text-muted);line-height:1.65;margin:0;">{person.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MAIN CONTENT -->
  <section style="padding:0 1.5rem 5rem;">
    <div class="prose" style="max-width:900px;margin:0 auto;">

      <h2>The Problem</h2>
      <p>Caribbean medical practices were managing patient records on paper or on foreign EMR systems that weren't built for how regional doctors actually work, whether that is the documentation patterns, the practice sizes, or the local infrastructure constraints. We built 3ST EMR to close that gap.</p>

      <h2>Delivered workflow</h2>
      <ol>
        <li>Manage appointments for the practice's practitioners.</li>
        <li>Find an existing patient record through server-paginated lists.</li>
        <li>Document the consultation in the clinical record for practitioner review.</li>
      </ol>
      <p>This case covers the appointment, record and documentation workflow. Patient-portal designs and other roadmap modules are not evidence of current availability; evaluate the current product with 3ST.</p>

      <h2>Three Versions to Get It Right</h2>

      {versions.map(v => (
        <div style="margin-bottom:2rem;">
          <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.625rem;">
            <h3 style="margin:0;">{v.heading}</h3>
            <span style={`font-size:0.6875rem;font-weight:700;text-transform:uppercase;letter-spacing:0.07em;padding:0.1875rem 0.625rem;border-radius:100px;white-space:nowrap;${v.status === 'Live' ? 'background:rgba(34,197,94,0.12);color:#4ade80;border:1px solid rgba(34,197,94,0.25);' : 'background:rgba(148,163,184,0.1);color:#94a3b8;border:1px solid rgba(148,163,184,0.2);'}`}>{v.status}</span>
          </div>
          {v.body.split('\n\n').map(para => (
            <p>{para}</p>
          ))}
        </div>
      ))}

      <div class="abc-focus">
        <h2 style="margin-top:0;text-wrap:balance;">Client in focus: ABC Paediatrics</h2>
        <p>The product team's existing account of <strong>ABC Paediatrics</strong> in Trinidad describes daily use across multiple practitioners, appointment management and clinical documentation. That reported use and feedback shaped the paediatric workflow.</p>

      </div>

      <h2>What this work demonstrates</h2>
      <p>Product iteration informed by practice feedback, a bounded record-list architecture and coordinated cloud, design and application delivery. For a clinic evaluating the software, use the existing 3ST product route. For a specialist contribution or team collaboration, contact me through this portfolio.</p>

    </div>
  </section>

  <!-- CONFERENCE PRESENCE -->
  <section style="padding:0 1.5rem 4rem;">
    <div style="max-width:900px;margin:0 auto;">
      <ConferenceGallery event={TTMA_2026} heading="At the booth" level="h2" size="sub" />
    </div>
  </section>

  <!-- FAQ -->
  <section style="padding:0 1.5rem 4rem;">
    <div style="max-width:900px;margin:0 auto;">
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map(item => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
      })} />
      <div class="reveal" style="margin-bottom:2rem;">
        <p style="font-size:0.8125rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-accent);margin:0 0 0.375rem;">FAQ</p>
        <h2 style="font-family:var(--font-display);font-size:1.625rem;font-weight:800;margin:0;">Common Questions</h2>
      </div>
      <div style="display:flex;flex-direction:column;gap:1rem;">
        {faq.map(item => (
          <div class="reveal" style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:12px;padding:1.75rem;">
            <h3 style="font-family:var(--font-display);font-size:1rem;font-weight:700;color:var(--color-text);margin:0 0 0.625rem;">{item.q}</h3>
            <p style="font-size:0.9375rem;color:var(--color-text-muted);line-height:1.7;margin:0;">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background:var(--color-surface);border-top:1px solid var(--color-border);padding:4rem 1.5rem;">
    <div style="max-width:900px;margin:0 auto;text-align:center;">
      <h2 style="font-family:var(--font-display);font-size:1.875rem;font-weight:800;margin-bottom:0.875rem;">Choose your next step</h2>
      <p style="color:var(--color-text-muted);margin-bottom:1.75rem;max-width:520px;margin-left:auto;margin-right:auto;">For individual architecture, integration or delivery leadership, or a scoped contribution alongside your existing team, contact me here. For the EMR itself, evaluate current plans with 3ST.</p>
      <a href="/contact" data-track="project_enquiry_intent" data-track-context="work-3-stripes-tech-cta" style="background:var(--color-accent-strong);color:#fff;padding:0.8125rem 1.75rem;border-radius:8px;font-weight:600;text-decoration:none;font-size:0.9375rem;display:inline-block;transition:background 0.2s;" onmouseover="this.style.background='var(--color-accent-strong-hover)'" onmouseout="this.style.background='var(--color-accent-strong)'">
        Discuss architecture or team delivery
      </a>
      <p style="margin-top:1.5rem;"><a href="https://www.3stripestech.com/pricing" target="_blank" rel="noopener noreferrer" style="color:var(--color-accent);">Evaluate the EMR at 3ST</a> · <a href="https://www.3stripestech.com/contact" target="_blank" rel="noopener noreferrer" style="color:var(--color-accent);">Ask 3ST about rollout</a></p>
    </div>
  </section>

  <CaseStudyLinks related={[CASE_STUDIES.esvd, CASE_STUDIES.qualitech]} />

</BaseLayout>

<style>
  /* The named-client section reads as the case study's centrepiece, using the
     same accent-tint callout the homepage and /work already use. */
  .abc-focus {
    margin: 2.5rem 0;
    padding: 1.75rem 1.75rem 0.5rem;
    background: rgba(255, 107, 43, 0.06);
    border: 1px solid rgba(255, 107, 43, 0.18);
    border-radius: 12px;
    box-shadow: inset 3px 0 0 var(--color-accent);
  }
  @media (max-width: 480px) {
    .abc-focus { padding: 1.25rem 1.25rem 0.25rem; }
  }
</style>
