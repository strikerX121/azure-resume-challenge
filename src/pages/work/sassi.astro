---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StaticContentFallback from '../../components/StaticContentFallback.astro';
import CoverBanner from '../../components/CoverBanner.astro';
import WorkSchema from '../../components/WorkSchema.astro';
import CaseStudyLinks from '../../components/CaseStudyLinks.astro';
import { CASE_STUDIES } from '../../data/internal-links';
import { Image } from 'astro:assets';
import nicoleImg from '../../assets/images/nicole-cumberbatch-sassi.jpg';
import clientPortalImg from '../../assets/images/sassi-client-portal.png';
import adminPortalImg from '../../assets/images/sassi-admin-portal.png';
import teamPhotoImg from '../../assets/images/sassi-team-photo.jpg';
import rakibImg from '../../assets/images/rakib-hasan.jpg';
---

<BaseLayout
  title="SASSI Logistics Platform | Azure Case Study"
  description="Antonio-led, team-delivered client work connecting SASSI's package-forwarding, customer and warehouse workflows on Azure."
  ogImage="/images/covers/sassi.jpg"
>

  <StaticContentFallback />
  <WorkSchema
    name="SASSI Logistics Platform"
    description="Antonio-led, team-delivered client work connecting SASSI's package-forwarding, customer and warehouse workflows on Azure."
    path="/work/sassi"
    breadcrumbLabel="SASSI Logistics Platform"
    creator={{ '@type': 'Person', name: 'Antonio Cumberbatch', url: 'https://www.antoniocumberbatch.com' }}
    about={['Logistics Software', 'Microsoft Azure', 'AI Support Systems', 'n8n Automation', 'Business Process Automation']}
  />


  <section style="padding:4rem 1.5rem 2rem;">
    <div style="max-width:900px;margin:0 auto;">
      <a href="/work" style="font-size:0.875rem;color:var(--color-text-muted);text-decoration:none;display:inline-flex;align-items:center;gap:0.375rem;margin-bottom:1.5rem;">&larr; All Work</a>
      <div class="reveal" style="background:rgba(255,107,43,0.06);border:1px solid rgba(255,107,43,0.18);border-radius:14px;padding:1.25rem 1.75rem;display:flex;align-items:center;gap:1.5rem;margin-bottom:1.75rem;">
        <div style="width:80px;height:80px;border-radius:12px;background:#fff;border:1px solid rgba(0,0,0,0.08);display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden;padding:8px;">
          <img src="/images/logos/sassi-logo.svg" alt="SASSI logo" width="64" height="64" loading="eager" decoding="async" style="width:64px;height:64px;object-fit:contain;" />
        </div>
        <div>
          <p style="font-family:var(--font-display);font-size:1.25rem;font-weight:700;color:var(--color-text);margin:0 0 0.375rem;">SASSI Logistics</p>
          <span style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--color-accent);">Logistics &amp; Supply Chain&nbsp;&middot; Azure&nbsp;&middot; Full-Stack</span>
          <div style="margin-top:0.625rem;">
            <a href="https://sassi4trinis.com/" target="_blank" rel="noopener noreferrer" style="font-size:0.8125rem;font-weight:600;color:var(--color-accent);text-decoration:none;border:1px solid rgba(255,107,43,0.35);border-radius:6px;padding:0.25rem 0.75rem;display:inline-flex;align-items:center;gap:0.375rem;transition:background 0.15s;" onmouseover="this.style.background='rgba(255,107,43,0.1)'" onmouseout="this.style.background='transparent'">
              Client's shipping website <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </div>
        </div>
      </div>
      <h1 class="reveal" style="font-family:var(--font-display);font-size:clamp(2rem,5vw,3.25rem);font-weight:800;line-height:1.2;margin-bottom:1.5rem;">SASSI Logistics Platform</h1>
      <div class="reveal" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1rem;">
        {[['Client delivery', 'Logistics platform'], ['Antonio-led', 'Team-delivered'], ['Azure', 'Cloud architecture']].map(([val, label]) => (
          <div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:8px;padding:1rem;text-align:center;">
            <div style="font-family:var(--font-display);font-size:1.5rem;font-weight:800;color:var(--color-accent);">{val}</div>
            <div style="font-size:0.8125rem;color:var(--color-text-muted);margin-top:0.25rem;">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CoverBanner name="sassi" />

  <section style="padding:2rem 1.5rem 5rem;">
    <div class="prose" style="max-width:900px;margin:0 auto;">

      <!-- ABOUT THE CLIENT -->
      <h2>At a glance</h2>
      <p><strong>Antonio-led, team-delivered client work.</strong> SASSI is a package-forwarding business, not a software product offered here. I independently led the engagement, bringing together the same delivery team I engaged for the EMR.</p>
      <p><strong>Evidence reviewed: November 10, 2026.</strong> This case describes delivered platform workflows. Later warehouse changes were reported released by the developer in October 2026, with client acknowledgement of visible updates. That is not full acceptance of every change or a fresh operational audit. Current usage totals are not asserted here.</p>
      <h2>Responsibilities</h2>
      <ul>
        <li><strong>Antonio Cumberbatch:</strong> Project management and scoping, hands-on cloud architecture and engineering, delivery coordination and customer success.</li>
        <li><strong>Naeem:</strong> primary application developer on the SASSI account.</li>
        <li><strong>Rakib Hasan:</strong> UI/UX and user-portal design, with his existing contribution below.</li>
        <li><strong>Automation:</strong> team-delivered n8n support workflow implementation.</li>
      </ul>
      <h2>About the Client</h2>
      <div style="display:flex;align-items:flex-start;gap:1.5rem;margin-bottom:1.5rem;flex-wrap:wrap;">
        <div style="display:flex;flex-direction:column;align-items:center;gap:0.5rem;flex-shrink:0;">
          <Image src={nicoleImg} width={96} height={96} alt="Nicole Cumberbatch, Founder of SASSI" style="width:96px;height:96px;border-radius:50%;object-fit:cover;object-position:center top;border:2px solid var(--color-border);" />
          <span style="font-size:0.6875rem;color:var(--color-text-muted);text-align:center;max-width:110px;line-height:1.4;">Nicole Cumberbatch<br/>Founder, SASSI</span>
        </div>
      </div>

      <h2>The Problem</h2>
      <p>SASSI needed to connect US warehouse receiving with customer pre-alerts, invoices and onward shipping to Trinidad. WhatsApp messages and spreadsheets left staff coordinating the same information across separate tools.</p>
      <p>The goal was a connected platform for customers and staff, shaped around the forwarding workflow rather than another isolated tracker.</p>

      <h2>What Was Built</h2>
      <p>A full-stack logistics web application on Azure, with customer and administrative views. Antonio led the work; design, application development and automation were team contributions.</p>

      <h3>Core Modules</h3>
      <ul>
        <li><strong>Client portal:</strong> pre-alerts, invoice management, wallet and payment tracking</li>
        <li><strong>Admin portal:</strong> warehouse receiving, pre-alert management, invoicing, reporting</li>
        <li><strong>SNS (Shop &amp; Ship):</strong> purchase-on-behalf service for US vendor purchases</li>
        <li><strong>Warehouse Receipt changes:</strong> October 2026 release reported by the developer; follow-up fixes and client review remain distinct from blanket completion</li>
        <li><strong>Support automation:</strong> an n8n workflow designed to check duplicates, create and assign Trello tickets and notify the delivery team</li>
      </ul>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:0.875rem;margin:1.75rem 0 0.5rem;">
        <div>
          <Image src={clientPortalImg} width={560} height={350} alt="SASSI client portal showing pre-alerts and the invoice view" style="width:100%;height:auto;border-radius:8px;border:1px solid var(--color-border);" />
          <p style="font-size:0.75rem;color:var(--color-text-muted);text-align:center;margin:0.5rem 0 0;">Client Portal</p>
        </div>
        <div>
          <Image src={adminPortalImg} width={560} height={350} alt="SASSI admin portal showing the warehouse receiving dashboard" style="width:100%;height:auto;border-radius:8px;border:1px solid var(--color-border);" />
          <p style="font-size:0.75rem;color:var(--color-text-muted);text-align:center;margin:0.5rem 0 0;">Admin Portal</p>
        </div>
      </div>

      <h2>Stack</h2>
      <p>Azure infrastructure, a full-stack web application, n8n automation, Trello API and Slack integration.</p>

      <h2>Delivered workflow</h2>
      <ol>
        <li>A customer records a pre-alert for an incoming package.</li>
        <li>Staff receive and match packages through the administrative workflow.</li>
        <li>Staff prepare invoices; the customer portal presents invoice and payment information.</li>
        <li>Shop &amp; Ship supports purchases made on a customer's behalf.</li>
      </ol>
      <h3>Support workflow design</h3>
      <p>Request → duplicate check → ticket creation → assignment and team notification → customer reference. This describes the implemented automation mechanism, not a response-time or staffing result. I remain the point of contact for routing customer requests; automated intake is not a promise of hands-off support.</p>

      <h2>Proof and current limits</h2>
      <p>The existing portal views above illustrate the customer and staff surfaces delivered by the team. The client acknowledged visible warehouse updates in October 2026; subsequent fixes and acceptance are separate. This portfolio review did not exercise the client system or verify support performance.</p>

      <h2>What this work demonstrates</h2>
      <p>Scoping a connected operational workflow, designing the cloud foundation and coordinating application, design and automation contributors around a client's process. A similar engagement would be scoped for its own requirements, not a sale of SASSI's platform.</p>

      <div style="margin-top:2rem;">
        <Image src={teamPhotoImg} width={900} height={500} alt="SASSI team" style="width:100%;height:auto;border-radius:10px;border:1px solid var(--color-border);object-fit:cover;" />
      </div>

    </div>
  </section>

  <!-- DESIGN CONTRIBUTOR -->
  <section style="padding:0 1.5rem 3rem;">
    <div style="max-width:900px;margin:0 auto;">
      <p class="reveal" style="font-size:0.8125rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-accent);margin:0 0 0.375rem;">Design</p>
      <h2 class="reveal" style="font-family:var(--font-display);font-size:1.625rem;font-weight:800;margin:0 0 1.25rem;">UI/UX</h2>
      <div class="card-lift reveal" style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:12px;padding:1.75rem;display:flex;gap:1.5rem;align-items:flex-start;flex-wrap:wrap;">
        <Image src={rakibImg} width={80} height={80} alt="Rakib Hasan" loading="lazy" decoding="async" style="width:80px;height:80px;border-radius:50%;object-fit:cover;object-position:center top;border:2px solid var(--color-border);flex-shrink:0;" />
        <div style="flex:1;min-width:240px;">
          <p style="font-family:var(--font-display);font-size:1rem;font-weight:700;color:var(--color-text);margin:0 0 0.25rem;">Rakib Hasan</p>
          <p style="font-size:0.8125rem;font-weight:600;color:var(--color-accent);margin:0 0 1rem;">UI/UX Designer &amp; Frontend Developer</p>
          <p style="font-size:0.9375rem;color:var(--color-text-muted);line-height:1.7;margin:0;font-style:italic;">&ldquo;Working on SASSI allowed me to dive deep into information architecture and data clarity. I led the design of the user portal, focusing heavily on simplifying shipment tracking and pre-alert systems. By balancing a clean aesthetic with powerful functionality, we built a platform that makes managing complex global logistics feel effortless.&rdquo;</p>
        </div>
      </div>
    </div>
  </section>

  <section style="background:var(--color-surface);border-top:1px solid var(--color-border);padding:4rem 1.5rem;">
    <div style="max-width:900px;margin:0 auto;text-align:center;">
      <h2 style="font-family:var(--font-display);font-size:1.875rem;font-weight:800;margin-bottom:1rem;">Need a similar workflow or delivery contribution?</h2>
      <p style="color:var(--color-text-muted);margin-bottom:1.75rem;max-width:520px;margin-left:auto;margin-right:auto;">Tell me whether you need individual architecture or integration expertise, collaboration with an existing team, or a scoped team-delivered build.</p>
      <a href="/contact" data-track="project_enquiry_intent" data-track-context="work-sassi-cta" style="background:var(--color-accent-strong);color:#fff;padding:0.8125rem 1.75rem;border-radius:8px;font-weight:600;text-decoration:none;font-size:0.9375rem;display:inline-block;transition:background 0.2s;" onmouseover="this.style.background='var(--color-accent-strong-hover)'" onmouseout="this.style.background='var(--color-accent-strong)'">
        Discuss a similar workflow or delivery role
      </a>
    </div>
  </section>

  <CaseStudyLinks related={[CASE_STUDIES.qualitech, CASE_STUDIES.esvd]} />

</BaseLayout>
