---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SHOWCASE, IDEAS, CATALOGUE_STATS } from '../data/automations';

const flowCount = SHOWCASE.reduce((n, c) => n + c.flows.length, 0);
---

<BaseLayout
  title="Automations | Real n8n Workflows and Ideas for Your Business"
  description="A selection of the n8n automations 3 Stripes Technologies has built for sales, marketing, messaging, finance and support teams, plus practical automation ideas for clinics, logistics, sales and admin-heavy businesses."
>

  <!-- HEADER -->
  <section style="padding:4rem 1.5rem 3rem;">
    <div style="max-width:1200px;margin:0 auto;">
      <p class="reveal-immediate" style="font-size:0.8125rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-accent);margin-bottom:0.5rem;">Automation catalogue</p>
      <h1 class="reveal-immediate" style="font-family:var(--font-display);font-size:clamp(2rem,5vw,3rem);font-weight:800;margin-bottom:1rem;max-width:820px;text-wrap:balance;">Automations we have actually built, and the ones your business could run next.</h1>
      <p class="reveal-immediate" style="font-size:1.0625rem;color:var(--color-text-muted);max-width:680px;line-height:1.7;margin:0;">
        These are real workflows from the 3 Stripes Technologies automation practice, built on n8n for teams in sales, distribution, healthcare, logistics and professional services. Client details are removed; what each flow does is not.
      </p>

      <div class="reveal-immediate auto-stats" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-top:2.25rem;max-width:720px;">
        {[
          [String(CATALOGUE_STATS.workflows), 'Workflows in the catalogue'],
          [String(CATALOGUE_STATS.categories), 'Business areas covered'],
          [String(flowCount), 'Featured below'],
        ].map(([val, label]) => (
          <div style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:10px;padding:1rem 1.125rem;box-shadow:var(--shadow-sm);">
            <div style="font-family:var(--font-display);font-size:1.75rem;font-weight:800;color:var(--color-accent);line-height:1;">{val}</div>
            <div style="font-size:0.8125rem;color:var(--color-text-muted);margin-top:0.375rem;">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CREDIT -->
  <section style="padding:0 1.5rem 1.5rem;">
    <div class="reveal-immediate" style="max-width:1200px;margin:0 auto;background:rgba(255,107,43,0.06);border:1px solid rgba(255,107,43,0.15);border-radius:12px;padding:1.25rem 1.5rem;">
      <p style="font-size:0.9375rem;color:var(--color-text);line-height:1.7;margin:0;">
        <strong>Credit where it is due.</strong> This catalogue was compiled by {CATALOGUE_STATS.compiledBy}, who build and maintain much of the work in it. I set the architecture and scope; our team turns it into workflows that run.
      </p>
    </div>
  </section>

  <!-- CATEGORY JUMP LINKS -->
  <section style="padding:0 1.5rem 2.5rem;">
    <nav aria-label="Automation categories" style="max-width:1200px;margin:0 auto;display:flex;flex-wrap:wrap;gap:0.5rem;">
      {SHOWCASE.map(c => (
        <a href={`#${c.id}`} class="chip-link">{c.label}</a>
      ))}
      <a href="#ideas" class="chip-link chip-link-accent">Ideas for your business &darr;</a>
    </nav>
  </section>

  <!-- SHOWCASE -->
  {SHOWCASE.map((cat, i) => (
    <section id={cat.id} style={`padding:3.5rem 1.5rem;scroll-margin-top:72px;${i % 2 === 0 ? '' : 'background:var(--color-surface);border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border);'}`}>
      <div style="max-width:1200px;margin:0 auto;">
        <div class="reveal" style="margin-bottom:2rem;max-width:720px;">
          <p style="font-size:0.8125rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-accent);margin:0 0 0.375rem;">{String(i + 1).padStart(2, '0')} &middot; {cat.flows.length} {cat.flows.length === 1 ? 'workflow' : 'workflows'}</p>
          <h2 style="font-family:var(--font-display);font-size:1.75rem;font-weight:800;margin:0 0 0.5rem;">{cat.label}</h2>
          <p style="font-size:0.9375rem;color:var(--color-text-muted);line-height:1.7;margin:0;">{cat.intro}</p>
        </div>
        <div class={`flow-grid flow-grid-${cat.flows.length === 1 ? 1 : cat.flows.length <= 2 || cat.flows.length === 4 ? 2 : 3}`}>
          {cat.flows.map(f => (
            <article class="reveal flow-card" style={`background:${i % 2 === 0 ? 'var(--color-surface)' : 'var(--color-surface-2)'};`}>
              <p class="flow-for" style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.07em;color:var(--color-accent);margin:0 0 0.625rem;line-height:1.45;">{f.forWho}</p>
              <h3 style="font-family:var(--font-display);font-size:1.125rem;font-weight:700;color:var(--color-text);margin:0 0 0.625rem;">{f.title}</h3>
              <p style="font-size:0.9375rem;color:var(--color-text-muted);line-height:1.65;margin:0 0 1.25rem;flex:1;">{f.what}</p>
              <div class="flow-meta">
              <p style="font-size:0.8125rem;color:var(--color-text-muted);margin:0 0 0.75rem;line-height:1.5;"><span style="color:var(--color-text);font-weight:600;">Trigger:</span> {f.trigger}</p>
              <div style="display:flex;flex-wrap:wrap;gap:0.375rem;">
                {f.stack.map(t => (
                  <span style="font-family:var(--font-mono);font-size:0.75rem;background:var(--color-bg);color:#B8C6E0;padding:0.25rem 0.5rem;border-radius:4px;border:1px solid var(--color-border);">{t}</span>
                ))}
              </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- IDEAS -->
  <section id="ideas" style="padding:5rem 1.5rem 2.5rem;scroll-margin-top:72px;">
    <div style="max-width:1200px;margin:0 auto;">
      <div class="reveal" style="margin-bottom:2.25rem;max-width:720px;">
        <p style="font-size:0.8125rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-accent);margin:0 0 0.5rem;">For your business</p>
        <h2 class="accent-line" style="font-family:var(--font-display);font-size:2.25rem;font-weight:800;margin:0 0 0.75rem;">Automations worth considering</h2>
        <p style="font-size:1rem;color:var(--color-text-muted);line-height:1.7;margin:0;">Every idea here is a pattern already proven in the catalogue above, aimed at a different kind of business. If one of these describes a job someone on your team does every week, it is probably a good first automation.</p>
      </div>

      <div class="ideas-grid">
        {IDEAS.map(g => (
          <div class="reveal" style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:12px;padding:1.75rem;box-shadow:var(--shadow-sm);">
            <h3 style="font-family:var(--font-display);font-size:1.125rem;font-weight:700;color:var(--color-text);margin:0 0 1.125rem;padding-bottom:0.875rem;border-bottom:1px solid var(--color-border);">{g.business}</h3>
            <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.875rem;">
              {g.ideas.map(idea => (
                <li>
                  <p style="font-size:0.9375rem;font-weight:600;color:var(--color-text);margin:0 0 0.1875rem;display:flex;gap:0.5rem;line-height:1.45;"><span style="color:var(--color-accent);" aria-hidden="true">&#x2713;</span>{idea.title}</p>
                  <p style="font-size:0.8125rem;color:var(--color-text-muted);margin:0 0 0 1.375rem;line-height:1.55;">Replaces: {idea.replaces}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW WE SCOPE -->
  <section style="padding:0 1.5rem 5rem;">
    <div style="max-width:1200px;margin:0 auto;">
      <div class="reveal scope-card" style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:12px;padding:2rem;box-shadow:var(--shadow-sm);">
        <h2 style="font-family:var(--font-display);font-size:1.375rem;font-weight:800;margin:0 0 1.5rem;">How an automation gets scoped</h2>
        <ol class="auto-steps" style="list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem;">
          {[
            ['1', 'Find the repeated job', 'We map one process end to end and pick the step that costs the most time or goes wrong most often.'],
            ['2', 'Centralise the data', 'Automation on top of scattered spreadsheets just moves the mess faster. The source of truth comes first.'],
            ['3', 'Automate with a human owner', 'Every workflow has a person who owns it, a log of what it did, and a clear point where it hands off.'],
          ].map(([n, t, d]) => (
            <li>
              <span style="display:inline-flex;width:36px;height:36px;border-radius:10px;background:rgba(255,107,43,0.15);border:1px solid rgba(255,107,43,0.25);color:var(--color-accent);font-family:var(--font-display);font-weight:800;font-size:0.875rem;align-items:center;justify-content:center;margin-bottom:0.875rem;" aria-hidden="true">{n}</span>
              <p style="font-weight:700;color:var(--color-text);margin:0 0 0.375rem;">{t}</p>
              <p style="font-size:0.875rem;color:var(--color-text-muted);line-height:1.6;margin:0;">{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background:var(--color-surface);border-top:1px solid var(--color-border);padding:4rem 1.5rem;">
    <div style="max-width:720px;margin:0 auto;text-align:center;">
      <h2 class="reveal" style="font-family:var(--font-display);font-size:2rem;font-weight:800;margin-bottom:1rem;">Have a process that should run itself?</h2>
      <p class="reveal" style="font-size:1rem;color:var(--color-text-muted);line-height:1.7;margin:0 0 2rem;">Tell me which job eats the most hours each week. A working session maps it, names the tools and gives you a build estimate.</p>
      <div class="reveal" style="display:flex;flex-wrap:wrap;gap:1rem;justify-content:center;">
        <a href="/contact/" data-track="project_enquiry_intent" data-track-context="automations-cta" class="btn btn-primary">Discuss an automation</a>
        <a href="/shop/" class="btn btn-secondary">Book a workflow consultation</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Flow cards sit in wrapping flex rows rather than a fixed grid, so a short
     last row shares the width evenly (5 cards = 3 + 2 halves) instead of one
     card stretching across two columns with dead space inside it. */
  .flow-grid { display: flex; flex-wrap: wrap; gap: 1.25rem; }
  .flow-grid > .flow-card { flex: 1 1 calc((100% - 2 * 1.25rem) / 3); min-width: 0; }
  .flow-grid-2 > .flow-card { flex-basis: calc((100% - 1.25rem) / 2); }
  .flow-grid-1 { max-width: 760px; }
  .flow-grid-1 > .flow-card { flex-basis: 100%; }
  .flow-card {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.625rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.25s ease;
  }
  .flow-card:hover { border-color: rgba(255, 107, 43, 0.30); }
  /* Trigger + stack always sit on the card's bottom edge, behind a hairline,
     so every card in a row ends on the same line. */
  .flow-meta { margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--color-border); }
  /* Two-line slot for the audience label so titles line up across a row. */
  .flow-for { min-height: 2.9em; }
  .flow-grid-1 .flow-for { min-height: 0; }
  .ideas-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  @media (max-width: 960px) {
    .flow-grid-3 > .flow-card { flex-basis: calc((100% - 1.25rem) / 2); }
  }
  @media (max-width: 640px) {
    .flow-grid > .flow-card, .flow-grid-2 > .flow-card, .flow-grid-3 > .flow-card { flex-basis: 100%; }
    .flow-card { padding: 1.375rem; }
    .flow-for { min-height: 0; }
    .ideas-grid { grid-template-columns: 1fr; }
    /* Three 100px tiles squeezed the labels onto 2-3 lines each; on phones
       the stats become compact rows, number left, label right. */
    .auto-stats { grid-template-columns: 1fr !important; gap: 0.5rem !important; margin-top: 1.75rem !important; }
    .auto-stats > div { display: flex; align-items: center; gap: 0.875rem; padding: 0.75rem 1rem !important; }
    .auto-stats > div > div:first-child { font-size: 1.5rem !important; min-width: 2.25rem; }
    .auto-stats > div > div:last-child { margin-top: 0 !important; font-size: 0.875rem !important; }
    .auto-steps { grid-template-columns: 1fr !important; gap: 1.25rem !important; }
    .scope-card { padding: 1.5rem !important; }
  }
</style>
