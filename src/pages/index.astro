---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import meImg from '../assets/images/me.png';
import { postSlug } from '../data/internal-links';

let recentPosts = [];
try {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  recentPosts = allPosts
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
} catch (e) {}

const stats = [
  { value: '11+', label: 'Years in IT and cloud' },
  { value: '2574+', label: 'Professionals trained on Copilot', format: 'locale' },
  { value: '95', label: 'Copilot workshops delivered' },
  { value: '5', label: 'Active Azure certifications' },
  { value: '20+', label: 'Clients served' },
];

// Featured work mirrors /work. Delivery status and acceptance status are kept
// separate: a running host proves a process is up, not that a client signed
// off. Client-reported figures are labelled as reported rather than measured.
const featuredWork = [
  {
    title: 'Enterprise Apps Masterview',
    category: 'Internal Operations Platform',
    desc: 'One operations portal replacing Azure Portal, spreadsheets, expense email chains and the Toggl UI. Nightly cost syncs, role-scoped views, atomic campaign claiming and guarded automation triggers, covered by 31 test suites.',
    tags: ['Next.js 15', 'Cosmos DB', 'Azure'],
    href: '/work/esvd-dashboard/',
    logo: '/images/logos/3st-logo.svg',
    logoBg: '#0F1624',
  },
  {
    title: 'SASSI Logistics Platform',
    category: 'Logistics & Supply Chain',
    desc: 'A package-forwarding business moved off WhatsApp and spreadsheets onto a full-stack Azure platform: client portal, admin dashboard, warehouse receiving and an AI support assistant.',
    tags: ['Azure', 'n8n', 'PostgreSQL'],
    href: '/work/sassi/',
    logo: '/images/logos/sassi-logo.svg',
    logoBg: '#fff',
  },
  {
    title: '3 Stripes Tech EMR',
    category: 'Healthcare IT',
    desc: 'A cloud-based electronic medical record system built for Caribbean healthcare providers. Co-founded and architected the V3 rebuild, from Azure infrastructure through the API layer.',
    tags: ['NestJS', 'React', 'Azure Front Door'],
    href: '/work/3-stripes-tech/',
    logo: '/images/logos/3st-logo.svg',
    logoBg: '#0F1624',
  },
  {
    title: 'Qualitech, QT Digital',
    category: 'Automation & Integration',
    desc: 'Seven isolated spreadsheets consolidated behind delivered workflow automation, with a department portal built and deployed and now inside the client review gate.',
    tags: ['n8n', 'Retell AI', 'Azure'],
    href: '/work/qualitech/',
    logo: '/images/logos/qualitech-logo.png',
    logoBg: '#fff',
  },
];

// Capability cards follow the approved CV's positioning: cloud architecture,
// automation and integration, and technical delivery, with Copilot enablement
// kept as a proven adjacent practice rather than the headline.
const services = [
  {
    iconLabel: 'AZ',
    title: 'Cloud architecture on Azure',
    desc: 'Infrastructure design, migration, identity, networking and cost optimisation, plus Microsoft Solution Assessments where a decision needs evidence behind it.',
  },
  {
    iconLabel: 'INT',
    title: 'Automation and integration',
    desc: 'Connecting the systems a business already runs so data stops being re-entered by hand. Centralise first, automate second, and keep the result maintainable by the people who own it.',
  },
  {
    iconLabel: 'DEL',
    title: 'Technical delivery',
    desc: 'Scoping, architecture and delivery leadership for builds that need to survive handover: custom portals, full-stack applications and the deployment pipeline underneath them.',
  },
  {
    iconLabel: 'M365',
    title: 'Microsoft 365 and identity',
    desc: 'Tenant configuration, identity federation, endpoint management and licensing structures sized to the organisation rather than to a vendor quote.',
  },
  {
    iconLabel: 'CP',
    title: 'Copilot readiness and adoption',
    desc: 'Readiness assessment and adoption workshops. I delivered 95 workshops and trained 2,574+ professionals as the primary US delivery resource for the Microsoft 365 Copilot workshop programme.',
  },
];
---

<BaseLayout isHomepage={true}>

  <!-- HERO -->
  <section class="hero-grid" style="min-height:90vh;display:flex;align-items:center;position:relative;overflow:hidden;padding:5rem 1.5rem;background:linear-gradient(160deg,#0F1B3D 0%,var(--color-navy) 100%);">
    <div style="max-width:1200px;margin:0 auto;width:100%;display:grid;grid-template-columns:1fr auto;gap:3rem;align-items:center;" class="hero-inner">
      <div>
        <div class="reveal" style="display:inline-flex;align-items:center;gap:0.5rem;background:rgba(255,107,43,0.12);border:1px solid rgba(255,107,43,0.25);border-radius:100px;padding:0.375rem 0.875rem;margin-bottom:1.5rem;">
          <span style="width:8px;height:8px;border-radius:50%;background:var(--color-accent);animation:pulse 2s infinite;"></span>
          <span style="font-size:0.8125rem;font-weight:500;color:var(--color-accent);">Available for new projects</span>
        </div>

        <h1 class="reveal" style="font-family:var(--font-display);font-size:clamp(2.25rem,5vw,3.75rem);font-weight:800;line-height:1.12;margin-bottom:1.5rem;color:var(--color-text);">
          Cloud architecture and automation that turn fragmented operations into{' '}
          <span style="color:var(--color-accent);">reliable business systems.</span>
        </h1>

        <p class="reveal" style="font-size:1.0625rem;color:var(--color-text-muted);max-width:560px;margin-bottom:1rem;line-height:1.7;">
          I help businesses connect their cloud infrastructure, applications and workflows, from Microsoft 365 and Azure through to custom portals and practical automation. Based in Trinidad and Tobago, working remotely, leading scoping, architecture and technical delivery through ARC Cloud Consulting and 3 Stripes Technologies.
        </p>

        <p class="reveal" style="font-size:0.9375rem;color:var(--color-text-muted);margin-bottom:2rem;">
          Cloud Solutions Architect. Automation and integration. Technical delivery.
        </p>

        <p class="reveal" style="font-size:0.875rem;color:var(--color-text-muted);margin-bottom:2rem;">
          <span id="visit-counter-wrap" hidden>
            This page has been visited <span id="visit-counter" style="color:var(--color-accent);font-weight:700;"></span> times.
          </span>
        </p>

        <div class="reveal" style="display:flex;flex-wrap:wrap;gap:1rem;">
          <a href="/contact/" data-track="project_enquiry_intent" data-track-context="home-hero" style="background:var(--color-accent-strong);color:#fff;padding:0.8125rem 1.75rem;border-radius:8px;font-weight:600;text-decoration:none;font-size:0.9375rem;transition:background 0.2s;" onmouseover="this.style.background='var(--color-accent-strong-hover)'" onmouseout="this.style.background='var(--color-accent-strong)'">
            Discuss your project
          </a>
          <a href="/work/" style="background:transparent;color:var(--color-text);padding:0.8125rem 1.75rem;border-radius:8px;font-weight:600;text-decoration:none;font-size:0.9375rem;border:1px solid var(--color-border);transition:border-color 0.2s,color 0.2s;" onmouseover="this.style.borderColor='var(--color-accent)';this.style.color='var(--color-accent)'" onmouseout="this.style.borderColor='var(--color-border)';this.style.color='var(--color-text)'">
            See relevant work
          </a>
        </div>
      </div>

      <!-- Profile photo -->
      <div class="reveal hero-photo-wrap" style="flex-shrink:0;">
        <div style="width:280px;height:280px;border-radius:50%;overflow:hidden;border:3px solid rgba(255,107,43,0.4);box-shadow:0 0 0 8px rgba(255,107,43,0.08),0 16px 48px rgba(0,0,0,0.5);">
          <Image src={meImg} width={280} height={280} alt="Antonio Cumberbatch" loading="eager" fetchpriority="high" style="width:100%;height:100%;object-fit:cover;object-position:center top;" />
        </div>
      </div>
    </div>
  </section>

  <!-- PROOF BAR / STATS -->
  <section style="background:var(--color-surface);border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border);padding:3rem 1.5rem;">
    <div style="max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:2rem;text-align:center;">
      {stats.map((s) => (
        <div class="reveal">
          <div
            class="counter"
            data-target={s.value.replace(/\D/g, '')}
            data-suffix={s.value.replace(/[\d]/g, '')}
            data-format={s.format ?? ''}
            style="font-family:var(--font-display);font-size:2.75rem;font-weight:800;color:var(--color-accent);line-height:1;"
          >
            {s.format === 'locale' ? Number(s.value.replace(/\D/g, '')).toLocaleString() + s.value.replace(/[\d,]/g, '') : s.value}
          </div>
          <div style="font-size:0.9375rem;color:var(--color-text-muted);margin-top:0.375rem;">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- TWO WAYS TO WORK TOGETHER -->
  <section style="padding:5rem 1.5rem;">
    <div style="max-width:1200px;margin:0 auto;">
      <div class="reveal" style="margin-bottom:2.5rem;">
        <p style="font-size:0.8125rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-accent);margin-bottom:0.5rem;">How engagements work</p>
        <h2 class="accent-line" style="font-family:var(--font-display);font-size:2.25rem;font-weight:800;margin-bottom:0.75rem;">Two ways to work together</h2>
        <p style="font-size:1rem;color:var(--color-text-muted);max-width:640px;line-height:1.7;margin:0;">
          Most enquiries fall into one of two shapes. Knowing which one you are before we talk makes the first conversation considerably more useful.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem;">
        <div class="reveal" style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:12px;padding:2rem;">
          <h3 style="font-family:var(--font-display);font-size:1.25rem;font-weight:700;color:var(--color-text);margin:0 0 0.875rem;">A business with an operational problem</h3>
          <p style="font-size:0.9375rem;color:var(--color-text-muted);line-height:1.7;margin:0 0 1rem;">
            You have a process that breaks, duplicates data, or depends on one person remembering to do it. We diagnose a bounded problem, scope an implementation, and deliver it with a team behind it. Ongoing technical support follows if it makes sense, not by default.
          </p>
          <p style="font-size:0.875rem;color:var(--color-text-muted);line-height:1.6;margin:0;">
            Typical work: cloud architecture and migration, systems integration, workflow automation, a custom portal, managed Microsoft 365.
          </p>
        </div>

        <div class="reveal" style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:12px;padding:2rem;">
          <h3 style="font-family:var(--font-display);font-size:1.25rem;font-weight:700;color:var(--color-text);margin:0 0 0.875rem;">A team that needs one specialist</h3>
          <p style="font-size:0.9375rem;color:var(--color-text-muted);line-height:1.7;margin:0 0 1rem;">
            You have a delivery team and a gap: an architecture decision to make, an assessment to run, an integration nobody owns. You can contract me directly for that contribution without buying an entire agency alongside it.
          </p>
          <p style="font-size:0.875rem;color:var(--color-text-muted);line-height:1.6;margin:0;">
            Typical work: Azure architecture review, identity and integration design, solution assessment, technical delivery leadership on an existing programme.
          </p>
        </div>
      </div>

      <div class="reveal" style="margin-top:1.5rem;background:rgba(255,107,43,0.06);border:1px solid rgba(255,107,43,0.15);border-radius:12px;padding:1.5rem 1.75rem;">
        <p style="font-size:0.9375rem;color:var(--color-text);margin:0;line-height:1.7;">
          <strong>Looking for the EMR as a product?</strong> Clinical and practice-management enquiries are handled by 3 Stripes Technologies rather than here.
          <a href="https://www.3stripestech.com" target="_blank" rel="noopener noreferrer" style="color:var(--color-accent);text-decoration:underline;text-underline-offset:3px;">See 3 Stripes Technologies</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- CERTIFICATIONS -->
  <section style="padding:0 1.5rem 4rem;">
    <div style="max-width:1200px;margin:0 auto;">
      <div class="reveal" style="margin-bottom:2rem;">
        <p style="font-size:0.8125rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-accent);margin-bottom:0.375rem;">Credentials</p>
        <h2 style="font-family:var(--font-display);font-size:1.75rem;font-weight:800;">8 Microsoft credentials</h2>
        <p style="font-size:0.9375rem;color:var(--color-text-muted);margin-top:0.5rem;">5 active Azure certifications, 2 expired, and 1 legacy Windows Server credential. Expired entries are shown rather than hidden.</p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1rem;">
        {[
          { code: 'AZ-305', name: 'Azure Solutions Architect Expert', badge: 'https://learn.microsoft.com/en-us/media/learn/certification/badges/microsoft-certified-expert-badge.svg', status: 'Active' },
          { code: 'AZ-500', name: 'Azure Security Engineer Associate', badge: 'https://learn.microsoft.com/en-us/media/learn/certification/badges/microsoft-certified-associate-badge.svg', status: 'Active' },
          { code: 'AZ-104', name: 'Azure Administrator Associate', badge: 'https://learn.microsoft.com/en-us/media/learn/certification/badges/microsoft-certified-associate-badge.svg', status: 'Active' },
          { code: 'AI-900', name: 'Azure AI Fundamentals', badge: 'https://learn.microsoft.com/en-us/media/learn/certification/badges/microsoft-certified-fundamentals-badge.svg', status: 'Active' },
          { code: 'AZ-900', name: 'Azure Fundamentals', badge: 'https://learn.microsoft.com/en-us/media/learn/certification/badges/microsoft-certified-fundamentals-badge.svg', status: 'Active' },
          { code: 'AZ-700', name: 'Azure Network Engineer Associate', badge: 'https://learn.microsoft.com/en-us/media/learn/certification/badges/microsoft-certified-associate-badge.svg', status: 'Expired' },
          { code: 'AZ-140', name: 'Azure Virtual Desktop Specialty', badge: 'https://learn.microsoft.com/en-us/media/learn/certification/badges/microsoft-certified-specialty-badge.svg', status: 'Expired' },
          { code: 'M20740', name: 'Windows Server 2016', badge: null, status: 'Legacy' },
        ].map(cert => (
          <div class="card-lift reveal" style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:10px;padding:1.25rem;display:flex;align-items:center;gap:0.875rem;">
            {cert.badge
              ? <Image src={cert.badge} width={44} height={44} alt={cert.code + ' badge'} loading="lazy" decoding="async" style="width:44px;height:44px;object-fit:contain;flex-shrink:0;" />
              : <div style="width:44px;height:44px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;flex-shrink:0;" aria-hidden="true">&#x1FA9F;</div>
            }
            <div style="flex:1;min-width:0;">
              <p style="font-size:0.6875rem;font-weight:700;color:var(--color-accent);margin:0 0 0.2rem;letter-spacing:0.05em;">{cert.code}</p>
              <p style="font-size:0.8125rem;font-weight:600;color:var(--color-text);margin:0 0 0.375rem;line-height:1.3;">{cert.name}</p>
              <span style={`display:inline-flex;align-items:center;gap:0.3rem;font-size:0.625rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;padding:0.1875rem 0.5rem;border-radius:100px;${cert.status === 'Active' ? 'background:rgba(34,197,94,0.12);color:#4ade80;border:1px solid rgba(34,197,94,0.25);' : 'background:rgba(148,163,184,0.1);color:#b4c0d4;border:1px solid rgba(148,163,184,0.2);'}`}>
                {cert.status === 'Active' && <span style="width:5px;height:5px;border-radius:50%;background:#4ade80;display:inline-block;" aria-hidden="true"></span>}
                {cert.status}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURED WORK -->
  <section style="background:var(--color-surface);border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border);padding:5rem 1.5rem;">
    <div style="max-width:1200px;margin:0 auto;">
      <div class="reveal" style="margin-bottom:3rem;">
        <p style="font-size:0.8125rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-accent);margin-bottom:0.5rem;">Selected Work</p>
        <h2 class="accent-line" style="font-family:var(--font-display);font-size:2.25rem;font-weight:800;margin-bottom:0.75rem;">Systems in daily use</h2>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem;margin-bottom:2.5rem;">
        {featuredWork.map(p => (
          <a href={p.href} class="card-lift reveal" style="background:var(--color-surface-2);border:1px solid var(--color-border);border-radius:12px;padding:1.75rem;text-decoration:none;display:block;">
            <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.875rem;">
              <div style={`width:40px;height:40px;border-radius:8px;background:${p.logoBg};border:1px solid rgba(0,0,0,0.08);display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden;padding:4px;`}>
                <img src={p.logo} alt={p.title + ' logo'} width="32" height="32" loading="lazy" decoding="async" style="width:32px;height:32px;object-fit:contain;" />
              </div>
              <span style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--color-accent);">{p.category}</span>
            </div>
            <h3 style="font-family:var(--font-display);font-size:1.25rem;font-weight:700;color:var(--color-text);margin:0 0 0.75rem;">{p.title}</h3>
            <p style="font-size:0.9375rem;color:var(--color-text-muted);line-height:1.6;margin-bottom:1.25rem;">{p.desc}</p>
            <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1.25rem;">
              {p.tags.map(tag => (
                <span style="font-family:var(--font-mono);font-size:0.75rem;background:var(--color-surface);color:var(--color-text-muted);padding:0.25rem 0.625rem;border-radius:4px;">{tag}</span>
              ))}
            </div>
            <span style="font-size:0.875rem;font-weight:600;color:var(--color-accent);">View case study &rarr;</span>
          </a>
        ))}
      </div>

      <div class="reveal" style="text-align:center;">
        <a href="/work/" style="font-size:0.9375rem;font-weight:600;color:var(--color-accent);text-decoration:none;">View all work &rarr;</a>
      </div>
    </div>
  </section>

  <!-- WHAT I DO -->
  <section style="padding:5rem 1.5rem;">
    <div style="max-width:1200px;margin:0 auto;">
      <div class="reveal" style="margin-bottom:3rem;">
        <p style="font-size:0.8125rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-accent);margin-bottom:0.5rem;">Capabilities</p>
        <h2 class="accent-line" style="font-family:var(--font-display);font-size:2.25rem;font-weight:800;">Where I actually help</h2>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.5rem;">
        {services.map(s => (
          <div class="reveal" style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:12px;padding:2rem;">
            <div style="display:inline-flex;align-items:center;justify-content:center;min-width:48px;height:48px;padding:0 0.5rem;background:rgba(255,107,43,0.15);border:1px solid rgba(255,107,43,0.25);border-radius:10px;font-family:var(--font-display);font-size:0.75rem;font-weight:800;color:var(--color-accent);letter-spacing:0.05em;margin-bottom:1rem;">{s.iconLabel}</div>
            <h3 style="font-family:var(--font-display);font-size:1.125rem;font-weight:700;color:var(--color-text);margin-bottom:0.75rem;">{s.title}</h3>
            <p style="font-size:0.9375rem;color:var(--color-text-muted);line-height:1.6;margin:0;">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LATEST FROM THE BLOG -->
  <section style="background:var(--color-surface);border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border);padding:5rem 1.5rem;">
    <div style="max-width:1200px;margin:0 auto;">
      <div class="reveal" style="margin-bottom:3rem;">
        <p style="font-size:0.8125rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-accent);margin-bottom:0.5rem;">Writing</p>
        <h2 class="accent-line" style="font-family:var(--font-display);font-size:2.25rem;font-weight:800;">Latest from the blog</h2>
      </div>

      {recentPosts.length > 0 && (
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem;margin-bottom:2.5rem;">
          {recentPosts.map(post => (
            <a href={`/blog/${postSlug(post)}/`} class="card-lift reveal" style="background:var(--color-surface-2);border:1px solid var(--color-border);border-radius:12px;padding:1.75rem;text-decoration:none;display:block;">
              <span style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--color-accent);">{post.data.category}</span>
              <h3 style="font-family:var(--font-display);font-size:1.125rem;font-weight:700;color:var(--color-text);margin:0.625rem 0 0.75rem;">{post.data.title}</h3>
              <p style="font-size:0.9375rem;color:var(--color-text-muted);line-height:1.6;margin-bottom:1rem;">{post.data.description}</p>
              <span style="font-size:0.8125rem;color:var(--color-text-muted);">{new Date(post.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
            </a>
          ))}
        </div>
      )}

      <div class="reveal" style="text-align:center;">
        <a href="/blog/" style="font-size:0.9375rem;font-weight:600;color:var(--color-accent);text-decoration:none;">View all posts &rarr;</a>
      </div>
    </div>
  </section>

  <!-- LEAD MAGNET CALLOUT -->
  <section style="padding:4rem 1.5rem 1rem;">
    <div style="max-width:1200px;margin:0 auto;">
      <div class="reveal lead-magnet" style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:12px;padding:2rem 2.5rem;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2rem;align-items:center;">
        <div>
          <p style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-accent);margin:0 0 0.5rem;">Free download</p>
          <p style="font-family:var(--font-display);font-size:1.125rem;font-weight:700;color:var(--color-text);margin:0 0 0.375rem;">Is your team actually ready for Microsoft Copilot?</p>
          <p style="font-size:0.875rem;color:var(--color-text-muted);margin:0;">The AI and Copilot Staff Readiness Checklist, built from training 2,574+ professionals on Copilot adoption across North America.</p>
        </div>
        <div style="flex-shrink:0;">
