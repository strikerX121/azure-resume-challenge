---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  isHomepage?: boolean;
  isBlogPost?: boolean;
  pubDate?: string;
}

const {
  title = 'Antonio Cumberbatch | Cloud Solutions Architect, Automation and Integration',
  description = 'Cloud Solutions Architect working across Azure architecture, automation and integration, and technical delivery. Based in Trinidad and Tobago, delivering remotely for business and consulting teams.',
  ogImage = '/images/og-antonio.jpg',
  ogType = 'website',
  canonicalUrl,
  isHomepage = false,
  isBlogPost = false,
  pubDate,
} = Astro.props;

const siteUrl = 'https://www.antoniocumberbatch.com';

// Canonical URLs are normalised to the trailing-slash form so the canonical link
// on every page matches exactly what @astrojs/sitemap emits for the same route.
// Before this, pages canonicalised to "/about" while the sitemap declared
// "/about/", and both URLs answered 200 with identical bytes, leaving two
// competing addresses for one page. Root stays "/" and any route whose last
// segment carries a file extension keeps its extension form.
function canonicalise(rawPath: string): string {
  if (!rawPath || rawPath === '/') return siteUrl + '/';
  const pathOnly = rawPath.split('?')[0].split('#')[0];
  const trimmed = pathOnly.replace(/\/+$/, '');
  if (trimmed === '') return siteUrl + '/';
  const lastSegment = trimmed.split('/').pop() ?? '';
  if (lastSegment.includes('.')) return siteUrl + trimmed;
  return siteUrl + trimmed + '/';
}

const canonical = canonicalise(
  canonicalUrl ? new URL(canonicalUrl, siteUrl).pathname : Astro.url.pathname
);
const fullOgImage = ogImage.startsWith('http') ? ogImage : siteUrl + ogImage;

// Positioning note: the professional line here is the same one the approved CV
// leads with, so the site, the structured data and the downloadable document
// describe one person rather than three. Copilot and AI enablement stay visible
// as proven capabilities rather than as the headline identity.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Antonio Cumberbatch',
  alternateName: 'Antonio Ricardo Cumberbatch',
  jobTitle: 'Cloud Solutions Architect',
  description: 'Cloud Solutions Architect with 11+ years in cloud infrastructure and transformation, working across Azure architecture, automation and integration, and technical delivery. Delivered the Microsoft 365 Copilot workshop programme as its primary US delivery resource, training 2,574+ professionals. Founder of ARC Cloud Consulting and co-founder of 3 Stripes Technologies.',
  url: siteUrl,
  image: siteUrl + '/images/og-antonio.jpg',
  sameAs: [
    'https://www.linkedin.com/in/antonio-c-484433137/',
    'https://www.instagram.com/arc.cloudconsulting/',
  ],
  worksFor: [
    { '@type': 'Organization', name: 'ARC Cloud Consulting', url: 'https://www.arccloudconsulting.com' },
    { '@type': 'Organization', name: '3 Stripes Technologies', url: 'https://www.3stripestech.com' },
  ],
  knowsAbout: [
    'Microsoft Azure', 'Cloud Architecture', 'Cloud Migration',
    'Solution Assessments', 'Identity and Access Management',
    'Systems Integration', 'Workflow Automation', 'Business Process Automation',
    'Technical Delivery Management', 'Custom Portals',
    'Microsoft Copilot', 'AI Adoption',
    'n8n Automation', 'NestJS', 'Electronic Medical Records',
    'Caribbean Tech Consulting',
  ],
  address: { '@type': 'PostalAddress', addressCountry: 'TT' },
};

// WebSite schema gives search and AI assistants a single named entity for the
// site itself, separate from the Person it describes.
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Antonio Cumberbatch',
  alternateName: 'Antonio Cumberbatch, Cloud Solutions Architect',
  url: siteUrl,
  inLanguage: 'en',
  description: 'Cloud architecture, automation and integration, and technical delivery for business and consulting teams across the Caribbean and beyond.',
  publisher: { '@type': 'Person', name: 'Antonio Cumberbatch', url: siteUrl },
};

const articleSchema = isBlogPost ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  author: { '@type': 'Person', name: 'Antonio Cumberbatch' },
  datePublished: pubDate,
  url: canonical,
} : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={fullOgImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Antonio Cumberbatch" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={fullOgImage} />

  <!-- Sitemap (generated by @astrojs/sitemap) -->
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- llms.txt, an AI-readable site summary -->
  <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />

  <!-- RSS Feed -->
  <link rel="alternate" type="application/rss+xml" title="Antonio Cumberbatch, blog" href="/rss.xml" />

  <!-- Google Fonts (async to avoid render-blocking) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400&display=swap" /></noscript>

  <!-- JSON-LD: Person + WebSite on every page -->
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  {isBlogPost && articleSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  )}

  <!-- Google Analytics 4. The measurement ID below is the one already configured
       for this site and already serving in production. It is not a new property. -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-B7EJB7Y1HL"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    // IP anonymisation on, advertising signals off. This site has no advertising
    // use case, so it should not ship one.
    gtag('config', 'G-B7EJB7Y1HL', {
      anonymize_ip: true,
      allow_google_signals: false,
      allow_ad_personalization_signals: false,
    });
  </script>

  <!-- OneSignal Web Push -->
  <script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
  <script>
    window.OneSignalDeferred = window.OneSignalDeferred || [];
    OneSignalDeferred.push(async function(OneSignal) {
      await OneSignal.init({
        appId: "e7e4cd9f-52cd-4fae-836a-45605b70aaa5",
        safari_web_id: "web.onesignal.auto.170dfd78-50f3-4c48-aaba-810262274b60",
        notifyButton: {
          enable: true,
          position: 'bottom-left',
        },
      });
    });
  </script>

  <slot name="head" />
</head>
<body>
  <Nav />
  <main>
    <slot />
  </main>
  <Footer />

  <!-- Engagement event hooks.
       These record intent signals worth reviewing: someone opening a contact
       route, downloading the CV, or starting an enquiry from a specific case
       study. A click is an intent signal and not a delivered lead, so the event
       names say "intent" rather than calling themselves conversions. Browser
       opt-out signals are honoured before anything is sent. -->
  <script>
    (function () {
      const nav = navigator as Navigator & { globalPrivacyControl?: boolean; msDoNotTrack?: string };
      const optedOut =
        nav.globalPrivacyControl === true ||
        nav.doNotTrack === '1' ||
        nav.msDoNotTrack === '1';

      function track(eventName: string, params: Record<string, unknown> = {}) {
        if (optedOut) return;
        const g = (window as any).gtag;
        if (typeof g !== 'function') return;
        g('event', eventName, params);
      }
      (window as any).arcTrack = track;

      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement | null;
        const link = target?.closest('a, button') as HTMLElement | null;
        if (!link) return;

        // An explicit annotation wins, so a page can name its own event.
        const declared = link.getAttribute('data-track');
        const context = link.getAttribute('data-track-context') || document.location.pathname;
        if (declared) {
          track(declared, { context });
          return;
        }

        const href = link.getAttribute('href') || '';
        if (!href) return;

        if (/\.pdf($|\?)/i.test(href)) {
          track('cv_download_intent', { context, file: href });
        } else if (href.startsWith('mailto:')) {
          track('contact_intent', { context, method: 'email' });
        } else if (href.includes('api.whatsapp.com') || href.startsWith('tel:')) {
          track('contact_intent', { context, method: 'whatsapp' });
        } else if (href.includes('calendar.app.google')) {
          track('contact_intent', { context, method: 'booking' });
        } else if (href === '/contact' || href === '/contact/') {
          track('contact_intent', { context, method: 'contact_page' });
        }
      }, { passive: true });
    })();
  </script>

  <!-- Scroll reveal -->
  <script>
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      // CSS already shows these; just mark them so state is consistent.
      document.querySelectorAll('.reveal').forEach(el => el.classList.add('visible'));
    } else {
      const observer = new IntersectionObserver(
        (entries, obs) => entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            // Reveal is one-shot, so stop observing and avoid paying for
            // intersection callbacks on every subsequent scroll.
            obs.unobserve(e.target);
          }
        }),
        // Start slightly before the element enters view so the transition has
        // finished by the time it is comfortably on screen.
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    }
  </script>

  <!-- Nav gains a shadow once the page is scrolled, so it reads as a layer
       above the content rather than a flat band. -->
  <script>
    const siteHeader = document.querySelector('header');
    if (siteHeader) {
      let ticking = false;
      const applyHeaderState = () => {
        const scrolled = window.scrollY > 8;
        siteHeader.style.boxShadow = scrolled
          ? '0 4px 20px rgba(0,0,0,0.35), 0 1px 0 rgba(255,255,255,0.06)'
          : '0 1px 0 rgba(255,255,255,0.06)';
        ticking = false;
      };
      window.addEventListener('scroll', () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(applyHeaderState);
        }
      }, { passive: true });
      applyHeaderState();
    }
  </script>
</body>
</html>

