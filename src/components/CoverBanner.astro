---
// Decorative cover art for a page hero. The art is generated by
// scripts/generate-covers.mjs (abstract motifs only, never a product
// screenshot), so it carries an empty alt and is hidden from assistive tech.
//
// `name` maps to public/images/covers/<name>.jpg plus its -640 variant.
interface Props {
  name: string;
  maxWidth?: string;
}

const { name, maxWidth = '900px' } = Astro.props;
const base = `/images/covers/${name}`;
---

<section class="cover-banner-wrap">
  <figure class="cover-banner" aria-hidden="true" style={`max-width:${maxWidth};`}>
    <img
      src={`${base}.jpg`}
      srcset={`${base}-640.jpg 640w, ${base}.jpg 1200w`}
      sizes={`(max-width: ${maxWidth}) calc(100vw - 3rem), ${maxWidth}`}
      alt=""
      width="1200"
      height="630"
      loading="eager"
      decoding="async"
    />
  </figure>
</section>

<style>
  .cover-banner-wrap {
    padding: 0 1.5rem 2rem;
  }
  .cover-banner {
    margin: 0 auto;
    aspect-ratio: 12 / 5;
    border-radius: 14px;
    border: 1px solid var(--color-border);
    overflow: hidden;
    background: var(--color-surface-2);
  }
  .cover-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 640px) {
    .cover-banner {
      aspect-ratio: 16 / 9;
      border-radius: 12px;
    }
  }
</style>
