---
/**
 * Hub link block shown at the foot of a case study, pointing back to
 * /capabilities and across to a sibling case study.
 *
 * Case studies previously linked only to /contact and /work, so the proof pages
 * formed no hub-and-spoke structure. Each case study now links back to the
 * capability hub and sideways to one related engagement.
 */
import type { InternalLink } from '../data/internal-links';
import { CAPABILITIES_LINK } from '../data/internal-links';

interface Props {
  /** One or two sibling case studies to cross-link. */
  related?: InternalLink[];
}

const { related = [] } = Astro.props;
---

<section style="padding:0 1.5rem 4rem;">
  <div style="max-width:900px;margin:0 auto;">
    <div class="reveal" style="margin-bottom:1.25rem;">
      <p style="font-size:0.8125rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--color-accent);margin:0 0 0.375rem;">Related</p>
      <h2 style="font-family:var(--font-display);font-size:1.625rem;font-weight:800;margin:0;">Where this fits.</h2>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem;">
      <a href={CAPABILITIES_LINK.href} class="card-lift reveal" style="background:rgba(255,107,43,0.06);border:1px solid rgba(255,107,43,0.18);border-radius:12px;padding:1.5rem;text-decoration:none;display:block;">
        <span style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--color-accent);">Capability Hub</span>
        <h3 style="font-family:var(--font-display);font-size:1.0625rem;font-weight:700;color:var(--color-text);margin:0.5rem 0 0.5rem;">{CAPABILITIES_LINK.label}</h3>
        <p style="font-size:0.9rem;color:var(--color-text-muted);line-height:1.6;margin:0 0 0.875rem;">{CAPABILITIES_LINK.blurb}</p>
        <span style="font-size:0.875rem;font-weight:600;color:var(--color-accent);">See the capability stack &rarr;</span>
      </a>
      {related.map(link => (
        <a href={link.href} class="card-lift reveal" style="background:var(--color-surface);border:1px solid var(--color-border);border-radius:12px;padding:1.5rem;text-decoration:none;display:block;">
          <span style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--color-accent);">Case Study</span>
          <h3 style="font-family:var(--font-display);font-size:1.0625rem;font-weight:700;color:var(--color-text);margin:0.5rem 0 0.5rem;">{link.label}</h3>
          <p style="font-size:0.9rem;color:var(--color-text-muted);line-height:1.6;margin:0 0 0.875rem;">{link.blurb}</p>
          <span style="font-size:0.875rem;font-weight:600;color:var(--color-accent);">View case study &rarr;</span>
        </a>
      ))}
    </div>
  </div>
</section>
