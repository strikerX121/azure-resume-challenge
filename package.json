{
  "name": "antoniocumberbatch-com",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/sync-pricing.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "check:copy": "node scripts/check-no-em-dashes.mjs",
    "check:upload": "node scripts/check-upload-policy.mjs",
    "check:render": "node scripts/check-critical-render.mjs",
    "check:content": "node scripts/check-content-policy.mjs",
    "sync:pricing": "node scripts/sync-pricing.mjs",
    "audit:build": "node scripts/audit-build.mjs",
    "verify": "node scripts/audit-build.mjs && node scripts/check-no-em-dashes.mjs && node scripts/check-upload-policy.mjs && node scripts/check-no-public-credentials.mjs && node scripts/check-critical-render.mjs && node scripts/check-content-policy.mjs && node scripts/sync-pricing.mjs --check",
    "optimize:images": "node scripts/optimize-images.mjs",
    "generate:covers": "node scripts/generate-covers.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.3.5",
    "tailwindcss": "^4.0.0"
  }
